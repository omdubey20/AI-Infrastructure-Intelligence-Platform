{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/servers/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/projects/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/cleanup/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/stats/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/discovery/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/whm/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ml/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ai/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/audit/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
